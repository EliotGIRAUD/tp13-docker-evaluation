# =========================================================================
# Variables d'environnement du TP13 — copier en .env puis adapter si besoin
# =========================================================================

# ---- API ----
API_PORT=3000
API_IMAGE_NAME=mon-api
API_IMAGE_TAG=1.0.0

# ---- Registry privé ----
# Sur le VPS, on utilise l'IP publique pour que les daemons distants (ex: GitHub Actions, autres machines)
# puissent éventuellement pousser/pull. Sur poste local, mettre localhost.
REGISTRY_HOST=185.98.137.102
REGISTRY_PORT=5000
REGISTRY_UI_PORT=8080

# ---- Variables PET (par service) ----
CAT_PET=cat
DOG_PET=dog

# ---- Reverse proxy Nginx ----
NGINX_PORT=80

# ---- Observabilité ----
# Sur OVH, les ports HTTP non standards (9000, 9090, 3001…) sont filtrés en amont.
# On utilise 808x qui passent. Prometheus n'est pas exposé publiquement
# (sécurité : pas d'auth) — accessible uniquement via Grafana (datasource interne).
GRAFANA_PORT=8081
PORTAINER_PORT=8083

# Identifiants Grafana (à changer impérativement en prod !)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
